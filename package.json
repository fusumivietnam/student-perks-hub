{
  "name": "student-perks-hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "local:start": "node scripts/local-start.mjs",
    "local:stop": "supabase stop",
