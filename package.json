    "db:schema:sync": "supabase db schema declarative sync --no-apply"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.49.0",
    "next": "16.3.7",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tailwind-merge": "3.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@types/node": "20.19.17",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "autoprefixer": "10.4.21",
    "eslint": "9.35.0",
    "eslint-config-next": "16.3.6",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.17",
    "tailwindcss-animate": "1.0.7",
    "typescript": "5.9.2",
    "supabase": "2.117.0"
  },
