# Canonical public origin used for metadata, canonical URLs, sitemap, and robots.
# Example: https://student-perks.example.com
NEXT_PUBLIC_SITE_URL=

# Remote/staging environments may set these explicitly.
# Local development generates .env.local via `pnpm local:start`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional server-only override. Local/Codespaces generates this automatically.
SUPABASE_INTERNAL_URL=
