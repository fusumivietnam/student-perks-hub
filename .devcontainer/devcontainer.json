{
  "name": "Student Perks Hub",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:1-24-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1.10.1": {}
  },
  "forwardPorts": [
    3000
  ],
  "portsAttributes": {
    "3000": {
      "label": "Student Perks Hub",
      "onAutoForward": "openPreview"
    }
  },
  "postCreateCommand": "corepack enable && corepack prepare pnpm@12.8.1 --activate && pnpm install",
  "customizations": {
    "vscode": {
      "extensions": [
        "bradlc.vscode-tailwindcss",
        "dbaeumer.vscode-eslint"
      ]
    }
  }
}
